<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive foreground: a terminal prompt ">_" in NetHunter blue/red, 108dp canvas,
     artwork kept within the ~72dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- subtle rounded terminal panel -->
    <path
        android:fillColor="#141C33"
        android:pathData="M30,34 L78,34 A4,4 0 0 1 82,38 L82,70 A4,4 0 0 1 78,74 L30,74 A4,4 0 0 1 26,70 L26,38 A4,4 0 0 1 30,34 Z" />
    <!-- title bar -->
    <path
        android:fillColor="#1793D1"
        android:pathData="M30,34 L78,34 A4,4 0 0 1 82,38 L82,42 L26,42 L26,38 A4,4 0 0 1 30,34 Z" />

    <!-- prompt chevron ">" in NetHunter blue -->
    <path
        android:strokeColor="#1793D1"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M36,50 L46,58 L36,66" />

    <!-- cursor underscore "_" in NetHunter red -->
    <path
        android:strokeColor="#D81A3F"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M52,66 L70,66" />
</vector>
